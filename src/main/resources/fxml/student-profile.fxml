<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studentbourse.controller.StudentProfileController"
      spacing="15"
      alignment="TOP_CENTER"
      stylesheets="@/css/student-profile.css">

    <Label text="Student Profile" styleClass="title"/>

    <GridPane hgap="15" vgap="15">
        <Label text="First Name"/>
        <TextField fx:id="firstNameField" GridPane.columnIndex="1"/>

        <Label text="Last Name" GridPane.rowIndex="1"/>
        <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Email" GridPane.rowIndex="2"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Phone" GridPane.rowIndex="3"/>
        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="University" GridPane.rowIndex="4"/>
        <TextField fx:id="universityField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Button text="Save Changes" onAction="#saveProfile"/>

    <Label fx:id="statusLabel"/>

    <Button text="Back to Dashboard" onAction="#goBack"/>

</VBox>
