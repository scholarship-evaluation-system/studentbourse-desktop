<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
        fx:controller="com.example.prueba_javafx.ViewTestController"
      style="-fx-padding: 30; -fx-background-color: #f5f5f5;">
    
    <Label text="View Tester - StudentBourse" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
    
    <Label text="Click on any button to open and test a view" 
           style="-fx-font-size: 14px; -fx-text-fill: #666;">
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>
    </Label>
    
    <Button text="Role Selection" onAction="#openRoleSelection" 
            prefWidth="250" prefHeight="40"
            style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"/>
    
    <Button text="Student Login" onAction="#openStudentLogin" 
            prefWidth="250" prefHeight="40"
            style="-fx-font-size: 14px; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>

    <Button text="Create Account (Student)" onAction="#openCreateAccountStudent" 
            prefWidth="250" prefHeight="40"
            style="-fx-font-size: 14px; -fx-background-color: #33A852; -fx-text-fill: white; -fx-cursor: hand;"/>
    
    <Button text="Student Dashboard" onAction="#openStudentDashboard" 
            prefWidth="250" prefHeight="40"
            style="-fx-font-size: 14px; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
    
    <Button text="Evaluator Login" onAction="#openEvaluatorLogin" 
            prefWidth="250" prefHeight="40"
            style="-fx-font-size: 14px; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand;"/>
    
    <Button text="Evaluator Dashboard" onAction="#openEvaluatorDashboard" 
            prefWidth="250" prefHeight="40"
            style="-fx-font-size: 14px; -fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand;"/>
</VBox>
